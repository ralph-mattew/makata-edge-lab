<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily PR-gated auto-experiment runner (macOS launchd LaunchAgent).
     Runs run-experiments-daily.sh at 10:00 local (after the engine's 09:00 ideation, so
     freshly-promoted specs and merged proposal PRs are picked up). Catches up once after wake.

     __LAB_DIR__ is a placeholder (the repo forbids committing personal home paths). Substitute
     your absolute lab checkout path at install time — launchd needs absolute paths and does not
     expand env vars in these fields:
       sed "s|__LAB_DIR__|$PWD|g" automation/com.makata.lab-experiments.daily.plist \
         > ~/Library/LaunchAgents/com.makata.lab-experiments.daily.plist
       launchctl load  ~/Library/LaunchAgents/com.makata.lab-experiments.daily.plist
       launchctl start com.makata.lab-experiments.daily   # optional: run once now
     Pause: touch STOP (in the lab root) or launchctl unload the plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.makata.lab-experiments.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__LAB_DIR__/auto_experiment/run-experiments-daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__LAB_DIR__</string>

    <!-- launchd does not source your shell profile; make python3 + git + gh + claude findable. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>10</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__LAB_DIR__/auto_experiment/daily-logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LAB_DIR__/auto_experiment/daily-logs/launchd.err.log</string>
</dict>
</plist>
