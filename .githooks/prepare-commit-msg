#!/bin/sh
# Append a DCO Signed-off-by trailer matching the commit author, if absent.
# Enable once per clone with:  git config core.hooksPath .githooks
# (equivalent to always passing `git commit -s`).
NAME=$(git config user.name)
EMAIL=$(git config user.email)
[ -n "$NAME" ] && [ -n "$EMAIL" ] || exit 0
git interpret-trailers --if-exists doNothing \
  --trailer "Signed-off-by: $NAME <$EMAIL>" --in-place "$1"
